# Copy to .env (docker-compose reads it). Everything is optional on a laptop except SECRET_KEY outside dev.
DATABASE_URL=sqlite:///./cinelog.db
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false
FORCE_HTTPS=false
TMDB_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
